# ==============================================================================
# DocuMind AI — Environment Configuration Template
# Copy this file to .env and configure your secret keys and thresholds.
# ==============================================================================

# Groq API Key (Required for LLM response generation and query rewriting)
GROQ_API_KEY=gsk_your_groq_api_key_here

# JWT Secret Key (Required for signing authentication session tokens)
JWT_SECRET_KEY=documind_enterprise_secure_jwt_secret_key_2026

# Embedding Model Name (Sentence-Transformers HuggingFace ID)
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Minimum Cosine Similarity Confidence Threshold for Answering Queries
CONFIDENCE_THRESHOLD=0.15

# NVIDIA GPU Acceleration (Set to 'all' or GPU index, e.g., '0')
NVIDIA_VISIBLE_DEVICES=all
